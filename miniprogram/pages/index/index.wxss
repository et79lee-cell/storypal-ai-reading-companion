.hero { padding: 54rpx 40rpx; border-radius: 38rpx; color: #fff; background: linear-gradient(150deg,#173f45,#44816a); margin-bottom: 48rpx; }
.badge { display: inline-block; padding: 10rpx 18rpx; border-radius: 99rpx; background: rgba(255,255,255,.16); font-size: 24rpx; }
.title { display: block; font-size: 66rpx; font-weight: 800; line-height: 1.15; margin: 28rpx 0; }
.desc { color: rgba(255,255,255,.8); }
.section-title { font-size: 38rpx; font-weight: 750; margin-bottom: 22rpx; }
.story { display: flex; gap: 26rpx; padding: 26rpx; }
.cover { width: 190rpx; height: 220rpx; flex: none; border-radius: 24rpx; background: linear-gradient(145deg,#cce9d8,#f7d89b); display: flex; align-items: center; justify-content: center; font-size: 74rpx; }
.story-copy { display: flex; flex-direction: column; justify-content: center; }
.story-title { font-size: 36rpx; font-weight: 750; }
.summary { font-size: 26rpx; line-height: 1.6; margin: 12rpx 0; }
.age { align-self: flex-start; padding: 8rpx 15rpx; border-radius: 99rpx; color: #245542; background: #dceee5; font-size: 22rpx; }
.notice { padding: 22rpx; margin-top: 24rpx; background: #fff3d5; border-radius: 18rpx; font-size: 25rpx; }
