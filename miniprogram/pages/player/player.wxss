.player-page { min-height: 100vh; padding: 60rpx 30rpx; background: linear-gradient(180deg,#173f45 0,#2e6b55 39%,#f5eee0 39%); }
.art { height: 340rpx; display: flex; align-items: center; justify-content: center; font-size: 86rpx; }
.player { padding: 42rpx 34rpx; min-height: 520rpx; }
.track { height: 10rpx; background: #e7ede9; border-radius: 10rpx; overflow: hidden; }
.bar { height: 100%; background: #f38b72; transition: width .3s; }
.state { display: block; color: #2e6b55; font-weight: 700; font-size: 24rpx; margin-top: 30rpx; }
.sentence { display: block; min-height: 210rpx; margin: 18rpx 0; font-family: serif; font-size: 42rpx; line-height: 1.75; }
.input-row { display: flex; gap: 12rpx; }
.input-row input { flex: 1; background: #f4f6f4; border-radius: 20rpx; padding: 0 20rpx; }
.send { width: 140rpx; background: #2e6b55; color: #fff; font-size: 26rpx; }
.controls { display: flex; justify-content: center; margin-top: 30rpx; }
.start { width: 280rpx; }
.interrupt { width: 116rpx; height: 116rpx; padding: 0; border-radius: 58rpx; background: #f38b72; color: #fff; font-size: 42rpx; }
.interrupt::after { border: 0; }
.hint { display: block; text-align: center; color: #7a8a84; font-size: 22rpx; margin-top: 24rpx; }
